---
import { site } from "../data/site";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={["inline-flex items-center gap-3", className]}>
  <svg
    xmlns='http://www.w3.org/2000/svg'
    viewBox='0 0 38.184 38.184'
    fill='none'
    class='h-6 w-6 shrink-0'
    aria-hidden='true'
  >
    <path
      d='M19.092 4.243l14.85 14.849-14.85 14.85-14.85-14.85z'
      stroke='var(--primary)'
      stroke-width='4'></path>
  </svg>

  <span
    class='font-sans text-[1.5rem] font-medium leading-none tracking-[-0.04em] text-heading'
  >
    {site.wordmark}
  </span>
</div>
