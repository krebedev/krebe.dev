---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['inline-flex items-center gap-2.5', className]}>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 20 20"
    fill="none"
    class="h-5 w-5 shrink-0"
    aria-hidden="true"
  >
    <path
      d="M10 1.75 18.25 10 10 18.25 1.75 10 10 1.75Z"
      stroke="var(--primary)"
      stroke-width="1.25"
      stroke-linejoin="round"></path>
  </svg>

  <span
    class="font-sans text-[0.9375rem] font-medium tracking-[-0.04em] text-foreground"
  >
    krebe<span class="text-primary">.</span>dev
  </span>
</div>
