<div id="site-cursor" class="site-cursor" aria-hidden="true"></div>

<script>
  const cursor = document.getElementById('site-cursor');
  if (!cursor) throw new Error('Site cursor not found');

  const canUseCustomCursor = window.matchMedia(
    '(hover: hover) and (pointer: fine)',
  ).matches;
  const prefersReducedMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)',
  ).matches;

  if (!canUseCustomCursor || prefersReducedMotion) {
    cursor.remove();
  } else {
    document.documentElement.classList.add('has-custom-cursor');

    const interactiveSelector =
      'a, button, [role="button"], input, textarea, select, label, summary';

    const SCALE_DEFAULT = 1;
    const SCALE_SHRINK = 0.4;
    const POSITION_SMOOTHNESS = 32;
    const SCALE_SMOOTHNESS = 14;
    const SETTLE_EPSILON = 0.05;
    const HIT_TEST_DISTANCE = 10;

    let pointerX = -100;
    let pointerY = -100;
    let currentX = -100;
    let currentY = -100;
    let targetScale = SCALE_DEFAULT;
    let currentScale = SCALE_DEFAULT;
    let lastHitTestX = -100;
    let lastHitTestY = -100;
    let lastFrameTime = 0;
    let motionRafId = 0;
    let active = false;
    let visible = false;

    const getTargetScale = (clientX: number, clientY: number) => {
      const target = document.elementFromPoint(clientX, clientY);
      const isInteractive =
        target instanceof Element && !!target.closest(interactiveSelector);
      return isInteractive ? SCALE_SHRINK : SCALE_DEFAULT;
    };

    const maybeUpdateTargetScale = (clientX: number, clientY: number) => {
      const moved = Math.hypot(clientX - lastHitTestX, clientY - lastHitTestY);
      if (moved < HIT_TEST_DISTANCE && visible) return;

      lastHitTestX = clientX;
      lastHitTestY = clientY;
      targetScale = getTargetScale(clientX, clientY);
    };

    const applyTransform = () => {
      cursor.style.transform = `translate3d(${currentX}px, ${currentY}px, 0) translate(-50%, -50%) scale(${currentScale})`;
    };

    const isSettled = () =>
      Math.hypot(pointerX - currentX, pointerY - currentY) < SETTLE_EPSILON &&
      Math.abs(targetScale - currentScale) < 0.001;

    const runMotion = (time: number) => {
      if (!active) {
        motionRafId = 0;
        return;
      }

      const delta = lastFrameTime ? (time - lastFrameTime) / 1000 : 1 / 60;
      lastFrameTime = time;

      const positionEase = 1 - Math.exp(-POSITION_SMOOTHNESS * delta);
      currentX += (pointerX - currentX) * positionEase;
      currentY += (pointerY - currentY) * positionEase;

      const scaleEase = 1 - Math.exp(-SCALE_SMOOTHNESS * delta);
      currentScale += (targetScale - currentScale) * scaleEase;

      applyTransform();

      if (isSettled()) {
        currentX = pointerX;
        currentY = pointerY;
        currentScale = targetScale;
        applyTransform();
        active = false;
        lastFrameTime = 0;
        motionRafId = 0;
        return;
      }

      motionRafId = requestAnimationFrame(runMotion);
    };

    const wakeMotion = () => {
      if (active) return;

      active = true;
      lastFrameTime = 0;
      if (!motionRafId) {
        motionRafId = requestAnimationFrame(runMotion);
      }
    };

    const onPointerMove = (event: PointerEvent) => {
      pointerX = event.clientX;
      pointerY = event.clientY;
      maybeUpdateTargetScale(pointerX, pointerY);

      if (!visible) {
        visible = true;
        currentX = pointerX;
        currentY = pointerY;
        currentScale = targetScale;
        cursor.classList.add('is-visible');
        applyTransform();
      }

      wakeMotion();
    };

    const onPointerLeave = () => {
      active = false;
      if (motionRafId) {
        cancelAnimationFrame(motionRafId);
        motionRafId = 0;
      }
      visible = false;
      cursor.classList.remove('is-visible');
      pointerX = -100;
      pointerY = -100;
      currentX = -100;
      currentY = -100;
      lastHitTestX = -100;
      lastHitTestY = -100;
      targetScale = SCALE_DEFAULT;
      currentScale = SCALE_DEFAULT;
      lastFrameTime = 0;
      applyTransform();
    };

    window.addEventListener('pointermove', onPointerMove, { passive: true });
    document.documentElement.addEventListener('pointerleave', onPointerLeave);

    document.addEventListener(
      'astro:before-swap',
      () => {
        active = false;
        cancelAnimationFrame(motionRafId);
        motionRafId = 0;
        window.removeEventListener('pointermove', onPointerMove);
        document.documentElement.removeEventListener(
          'pointerleave',
          onPointerLeave,
        );
        document.documentElement.classList.remove('has-custom-cursor');
      },
      { once: true },
    );
  }
</script>
