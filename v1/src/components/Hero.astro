---
import { site } from "../data/site";
---

<div
  id='hero-spacer'
  aria-hidden='true'
  style='height: calc(100dvh - var(--site-header-height, 5rem));'
>
</div>

<section
  id='hero'
  class='hero pointer-events-none fixed inset-x-0 z-0 flex flex-col'
  style='top: var(--site-header-height, 5rem); height: calc(100dvh - var(--site-header-height, 5rem));'
>
  <div class='hero-desktop-spacer flex-1' aria-hidden='true'></div>

  <div
    id='hero-name-container'
    class='hero-name-scroll w-full px-6 pb-10 sm:px-8 sm:pb-12 lg:px-10 lg:pb-14'
  >
    <h1
      id='hero-name'
      class='block w-full font-sans font-medium leading-[0.92] tracking-[-0.03em] text-hero-name whitespace-nowrap'
    >
      {site.name}
    </h1>
  </div>

  <div id='hero-copy-bounds' class='absolute inset-x-0 top-0'>
    <div
      id='hero-copy'
      class='hero-copy absolute w-full max-w-md px-6 text-center sm:px-8 lg:px-10'
    >
      <p
        class='text-xs font-medium uppercase tracking-[0.2em] text-hero-eyebrow sm:text-sm'
      >
        {site.heroEyebrow}
      </p>
      <p
        class='mt-4 text-base leading-relaxed text-hero-name sm:text-lg'
      >
        {site.heroStatement}
      </p>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    const hero = document.getElementById("hero");
    if (!hero) return;

    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    const stacked = window.matchMedia(
      "(pointer: coarse), (pointer: none), (max-width: 47.99rem)",
    ).matches;

    if (stacked || prefersReducedMotion) {
      hero.classList.add("hero--stacked");
    }
  })();
</script>

<script>
  const header = document.querySelector("header");
  const hero = document.getElementById("hero");
  const copyBounds = document.getElementById("hero-copy-bounds");
  const heroCopy = document.getElementById("hero-copy");
  const nameContainer = document.getElementById("hero-name-container");
  const name = document.getElementById("hero-name");

  if (!hero || !copyBounds || !heroCopy || !nameContainer || !name) {
    throw new Error("Hero elements not found");
  }

  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;
  const stackedHeroLayoutMq = window.matchMedia(
    "(pointer: coarse), (pointer: none), (max-width: 47.99rem)",
  );
  const interactiveHeroMq = window.matchMedia(
    "(pointer: fine) and (hover: hover) and (min-width: 48rem)",
  );

  let usingKeyboard = false;

  const isStackedHeroLayout = () =>
    stackedHeroLayoutMq.matches || usingKeyboard || prefersReducedMotion;

  const isInteractiveHero = () =>
    interactiveHeroMq.matches && !usingKeyboard && !prefersReducedMotion;

  const getPointerGap = () => {
    if (!interactiveHeroMq.matches) return 12;

    const cursorSize = parseFloat(
      getComputedStyle(document.documentElement)
        .getPropertyValue("--site-cursor-size")
        .trim(),
    );

    // Cursor is centered on the pointer; sit copy below the circle + clearance.
    const clearance = 28;
    return Number.isFinite(cursorSize) ? cursorSize / 2 + clearance : 78;
  };

  const COPY_SMOOTHNESS = { x: 8, y: 6 };
  const FLIP_HYSTERESIS = 32;
  const SETTLE_EPSILON = 0.5;

  type CopyLayout = {
    boundsRect: DOMRect;
    copyWidth: number;
    copyHeight: number;
    gap: number;
  };

  const clamp = (value: number, min: number, max: number) =>
    Math.min(Math.max(value, min), max);

  const copy = {
    pointerX: 0,
    pointerY: 0,
    hasPointer: false,
    targetX: 0,
    targetY: 0,
    currentX: 0,
    currentY: 0,
    placement: "below" as "below" | "above",
    lastFrameTime: 0,
    motionRafId: 0,
    layoutRafId: 0,
    pointerListenerActive: false,
    motionLoopActive: false,
  };

  const resetCopyMotion = () => {
    copy.lastFrameTime = 0;
    copy.placement = "below";
  };

  const syncHeaderHeight = () => {
    if (!header) return;
    document.documentElement.style.setProperty(
      "--site-header-height",
      `${header.offsetHeight}px`,
    );
  };

  const nameText = name.textContent ?? "";
  let nameMeasureCtx: CanvasRenderingContext2D | null = null;

  const measureNameWidth = (
    fontSize: number,
    typography: {
      fontStyle: string;
      fontWeight: string;
      fontFamily: string;
      letterSpacingEm: number;
    },
  ) => {
    if (!nameMeasureCtx) {
      const canvas = document.createElement("canvas");
      nameMeasureCtx = canvas.getContext("2d");
    }
    if (!nameMeasureCtx) return Number.POSITIVE_INFINITY;

    nameMeasureCtx.font = `${typography.fontStyle} ${typography.fontWeight} ${fontSize}px ${typography.fontFamily}`;
    const baseWidth = nameMeasureCtx.measureText(nameText).width;
    const spacing = typography.letterSpacingEm * fontSize;
    return baseWidth + spacing * Math.max(0, nameText.length - 1);
  };

  const fitName = () => {
    if (!nameText) return;

    const containerStyles = getComputedStyle(nameContainer);
    const maxWidth =
      nameContainer.clientWidth -
      parseFloat(containerStyles.paddingLeft) -
      parseFloat(containerStyles.paddingRight);

    if (maxWidth <= 0) return;

    const nameStyle = getComputedStyle(name);
    const currentSize = parseFloat(nameStyle.fontSize);
    const letterSpacingPx = parseFloat(nameStyle.letterSpacing);
    const letterSpacingEm =
      currentSize > 0 && Number.isFinite(letterSpacingPx)
        ? letterSpacingPx / currentSize
        : 0;

    const typography = {
      fontStyle: nameStyle.fontStyle,
      fontWeight: nameStyle.fontWeight,
      fontFamily: nameStyle.fontFamily,
      letterSpacingEm,
    };

    let low = 16;
    let high = 900;
    let best = low;

    while (low <= high) {
      const mid = Math.floor((low + high) / 2);

      if (measureNameWidth(mid, typography) <= maxWidth) {
        best = mid;
        low = mid + 1;
      } else {
        high = mid - 1;
      }
    }

    if (currentSize !== best) {
      name.style.fontSize = `${best}px`;
    }
  };

  const resetStaticCopyLayout = () => {
    copyBounds.style.cssText = "";
    heroCopy.style.cssText = "";
  };

  const syncCopyBounds = () => {
    const heroRect = hero.getBoundingClientRect();
    const nameRect = nameContainer.getBoundingClientRect();
    copyBounds.style.bottom = `${Math.max(0, heroRect.bottom - nameRect.top)}px`;
  };

  const NAME_DEAD_ZONE = 20;

  const getTargetPosition = (
    clientX: number,
    clientY: number,
    layout?: CopyLayout,
  ) => {
    const boundsRect = layout?.boundsRect ?? copyBounds.getBoundingClientRect();
    const copyWidth = layout?.copyWidth ?? heroCopy.offsetWidth;
    const copyHeight = layout?.copyHeight ?? heroCopy.offsetHeight;
    const gap = layout?.gap ?? getPointerGap();

    const x = clamp(clientX, boundsRect.left, boundsRect.right);
    const y = clamp(clientY, boundsRect.top, boundsRect.bottom);

    const relX = x - boundsRect.left;
    const relPointerY = y - boundsRect.top;
    const maxCopyTop = Math.max(
      0,
      boundsRect.height - copyHeight - NAME_DEAD_ZONE,
    );

    const belowTop = relPointerY + gap;
    const aboveTop = relPointerY - gap - copyHeight;
    const fitsBelow = belowTop <= maxCopyTop;
    const fitsAbove = aboveTop >= 0;

    if (copy.placement === "below") {
      if (!fitsBelow && fitsAbove) {
        copy.placement = "above";
      }
    } else if (fitsBelow && belowTop <= maxCopyTop - FLIP_HYSTERESIS) {
      copy.placement = "below";
    }

    let relY: number;

    if (copy.placement === "below") {
      relY = fitsBelow ? belowTop : clamp(belowTop, 0, maxCopyTop);
    } else if (fitsAbove) {
      relY = aboveTop;
    } else {
      relY = clamp(belowTop, 0, maxCopyTop);
    }

    return {
      x: clamp(relX, copyWidth / 2, boundsRect.width - copyWidth / 2),
      y: clamp(relY, 0, maxCopyTop),
    };
  };

  const applyCopyPosition = (x: number, y: number) => {
    heroCopy.style.transform = `translate3d(${x}px, ${y}px, 0) translate(-50%, 0)`;
  };

  const syncCopyTarget = () => {
    if (copy.hasPointer) {
      const { x, y } = getTargetPosition(copy.pointerX, copy.pointerY);
      copy.targetX = x;
      copy.targetY = y;
      return;
    }

    const boundsRect = copyBounds.getBoundingClientRect();
    const { x, y } = getTargetPosition(
      boundsRect.left + boundsRect.width / 2,
      boundsRect.top + boundsRect.height / 2 - getPointerGap(),
    );
    copy.targetX = x;
    copy.targetY = y;
    copy.currentX = copy.targetX;
    copy.currentY = copy.targetY;
    resetCopyMotion();
  };

  const prepareInteractiveCopy = () => {
    heroCopy.style.left = "0";
    heroCopy.style.top = "0";
    heroCopy.style.willChange = "transform";
  };

  const applyCopyMotion = () => {
    applyCopyPosition(copy.currentX, copy.currentY);
  };

  const syncInteractiveCopyLayout = () => {
    syncCopyBounds();
    prepareInteractiveCopy();
    syncCopyTarget();
    applyCopyMotion();
  };

  const stopCopyMotion = () => {
    if (copy.motionRafId) {
      cancelAnimationFrame(copy.motionRafId);
      copy.motionRafId = 0;
    }
    copy.motionLoopActive = false;
    copy.lastFrameTime = 0;
  };

  const wakeCopyMotion = () => {
    if (!isInteractiveHero() || prefersReducedMotion || copy.motionLoopActive) {
      return;
    }

    copy.motionLoopActive = true;
    copy.lastFrameTime = 0;
    copy.motionRafId = requestAnimationFrame(runCopyMotion);
  };

  const isCopySettled = () =>
    Math.hypot(copy.targetX - copy.currentX, copy.targetY - copy.currentY) <
    SETTLE_EPSILON;

  const syncInteractionMode = () => {
    const interactive = isInteractiveHero();

    if (interactive && !copy.pointerListenerActive) {
      window.addEventListener("pointermove", onPointerMove, { passive: true });
      copy.pointerListenerActive = true;
    } else if (!interactive && copy.pointerListenerActive) {
      window.removeEventListener("pointermove", onPointerMove);
      copy.pointerListenerActive = false;
      copy.hasPointer = false;
      stopCopyMotion();
    }
  };

  const updateLayout = () => {
    syncHeaderHeight();
    fitName();

    const stacked = isStackedHeroLayout();
    const interactive = isInteractiveHero();

    hero.classList.toggle("hero--stacked", stacked);
    document.documentElement.classList.toggle("hero-interactive", interactive);
    if (interactive) {
      heroCopy.setAttribute("aria-hidden", "true");
    } else {
      heroCopy.removeAttribute("aria-hidden");
    }

    if (stacked) {
      resetStaticCopyLayout();
    } else {
      syncInteractiveCopyLayout();
    }

    syncInteractionMode();
  };

  const scheduleLayoutUpdate = () => {
    if (copy.layoutRafId) return;

    copy.layoutRafId = requestAnimationFrame(() => {
      copy.layoutRafId = 0;
      updateLayout();
    });
  };

  const onPointerMove = (event: PointerEvent) => {
    if (!isInteractiveHero()) return;

    copy.pointerX = event.clientX;
    copy.pointerY = event.clientY;
    copy.hasPointer = true;
    wakeCopyMotion();
  };

  const runCopyMotion = (time: number) => {
    if (!copy.motionLoopActive) return;

    const layout: CopyLayout = {
      boundsRect: copyBounds.getBoundingClientRect(),
      copyWidth: heroCopy.offsetWidth,
      copyHeight: heroCopy.offsetHeight,
      gap: getPointerGap(),
    };

    if (copy.hasPointer) {
      const { x, y } = getTargetPosition(
        copy.pointerX,
        copy.pointerY,
        layout,
      );
      copy.targetX = x;
      copy.targetY = y;
    }

    const delta = copy.lastFrameTime
      ? (time - copy.lastFrameTime) / 1000
      : 1 / 60;
    copy.lastFrameTime = time;

    const easeX = 1 - Math.exp(-COPY_SMOOTHNESS.x * delta);
    const easeY = 1 - Math.exp(-COPY_SMOOTHNESS.y * delta);
    copy.currentX += (copy.targetX - copy.currentX) * easeX;
    copy.currentY += (copy.targetY - copy.currentY) * easeY;
    applyCopyPosition(copy.currentX, copy.currentY);

    if (isCopySettled()) {
      copy.currentX = copy.targetX;
      copy.currentY = copy.targetY;
      applyCopyPosition(copy.currentX, copy.currentY);
      stopCopyMotion();
      return;
    }

    copy.motionRafId = requestAnimationFrame(runCopyMotion);
  };

  const onKeyboardUse = (event: KeyboardEvent) => {
    if (event.key !== "Tab" || usingKeyboard) return;
    usingKeyboard = true;
    scheduleLayoutUpdate();
  };

  const onPointerUse = () => {
    if (!usingKeyboard) return;
    usingKeyboard = false;
    scheduleLayoutUpdate();
  };

  const layoutObserver = new ResizeObserver(scheduleLayoutUpdate);
  const layoutTargets = [hero, nameContainer, copyBounds, heroCopy];
  if (header) layoutTargets.push(header);
  layoutTargets.forEach((target) => layoutObserver.observe(target));

  scheduleLayoutUpdate();
  document.fonts?.ready.then(scheduleLayoutUpdate);

  window.addEventListener("resize", scheduleLayoutUpdate, { passive: true });
  window.addEventListener("keydown", onKeyboardUse, { passive: true });
  window.addEventListener("pointerdown", onPointerUse, { passive: true });
  stackedHeroLayoutMq.addEventListener("change", scheduleLayoutUpdate);
  interactiveHeroMq.addEventListener("change", scheduleLayoutUpdate);

  document.addEventListener(
    "astro:before-swap",
    () => {
      layoutObserver.disconnect();
      window.removeEventListener("resize", scheduleLayoutUpdate);
      window.removeEventListener("keydown", onKeyboardUse);
      window.removeEventListener("pointerdown", onPointerUse);
      window.removeEventListener("pointermove", onPointerMove);
      stackedHeroLayoutMq.removeEventListener("change", scheduleLayoutUpdate);
      interactiveHeroMq.removeEventListener("change", scheduleLayoutUpdate);
      document.documentElement.classList.remove("hero-interactive");
      cancelAnimationFrame(copy.layoutRafId);
      stopCopyMotion();
    },
    { once: true },
  );
</script>
