---
import { site } from '../data/site';
---

<div
  id="hero-spacer"
  aria-hidden="true"
  style="height: calc(100dvh - var(--site-header-height, 5rem));"
></div>

<section
  id="hero"
  class="hero pointer-events-none fixed inset-x-0 z-0 flex flex-col"
  style="top: var(--site-header-height, 5rem); height: calc(100dvh - var(--site-header-height, 5rem));"
>
  <div class="hero-desktop-spacer flex-1" aria-hidden="true"></div>

  <div id="hero-name-container" class="hero-name-scroll w-full px-6 pb-10 sm:px-8 sm:pb-12 lg:px-10 lg:pb-14">
    <h1
      id="hero-name"
      class="block w-full font-sans font-medium leading-[0.92] tracking-[-0.03em] text-hero-name whitespace-nowrap"
    >
      {site.name}
    </h1>
  </div>

  <div id="hero-copy-bounds" class="absolute inset-x-0 top-0">
    <div
      id="hero-copy"
      class="hero-copy absolute w-full max-w-md px-6 text-center sm:px-8 lg:px-10"
    >
      <p class="text-xs font-medium uppercase tracking-[0.2em] text-primary sm:text-sm">
        {site.heroEyebrow}
      </p>
      <p class="mt-4 text-base leading-relaxed text-muted-foreground sm:text-lg">
        {site.heroStatement}
      </p>
    </div>
  </div>
</section>

<script>
  const header = document.querySelector('header');
  const hero = document.getElementById('hero');
  const copyBounds = document.getElementById('hero-copy-bounds');
  const heroCopy = document.getElementById('hero-copy');
  const container = document.getElementById('hero-name-container');
  const name = document.getElementById('hero-name');

  if (!hero || !copyBounds || !heroCopy || !container || !name) {
    throw new Error('Hero elements not found');
  }

  const syncHeaderHeight = () => {
    if (!header) return;
    document.documentElement.style.setProperty(
      '--site-header-height',
      `${header.offsetHeight}px`,
    );
  };

  const getMaxTextWidth = () => {
    const styles = getComputedStyle(container);
    return (
      container.clientWidth -
      parseFloat(styles.paddingLeft) -
      parseFloat(styles.paddingRight)
    );
  };

  const fitName = () => {
    const maxWidth = getMaxTextWidth();
    if (maxWidth <= 0) return;

    let low = 16;
    let high = 900;
    let best = low;

    while (low <= high) {
      const mid = Math.floor((low + high) / 2);
      name.style.fontSize = `${mid}px`;

      if (name.scrollWidth <= maxWidth) {
        best = mid;
        low = mid + 1;
      } else {
        high = mid - 1;
      }
    }

    name.style.fontSize = `${best}px`;
  };

  const syncCopyBounds = () => {
    if (!hasFinePointer) return;

    const heroRect = hero.getBoundingClientRect();
    const nameRect = container.getBoundingClientRect();
    copyBounds.style.bottom = `${Math.max(0, heroRect.bottom - nameRect.top)}px`;
  };

  const resetStaticCopyLayout = () => {
    copyBounds.style.bottom = '';
    heroCopy.style.left = '';
    heroCopy.style.top = '';
    heroCopy.style.transform = '';
  };

  const clamp = (value: number, min: number, max: number) =>
    Math.min(Math.max(value, min), max);

  const prefersReducedMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)',
  ).matches;
  const hasFinePointer = window.matchMedia('(pointer: fine)').matches;

  const POINTER_GAP = 12;
  const SMOOTHNESS = 4.5;

  let pointerX = 0;
  let pointerY = 0;
  let hasPointer = false;
  let targetX = 0;
  let targetY = 0;
  let currentX = 0;
  let currentY = 0;
  let rafId = 0;
  let lastFrameTime = 0;

  const getTargetPosition = (clientX: number, clientY: number) => {
    const boundsRect = copyBounds.getBoundingClientRect();
    const copyWidth = heroCopy.offsetWidth;
    const copyHeight = heroCopy.offsetHeight;

    const x = clamp(clientX, boundsRect.left, boundsRect.right);
    const y = clamp(clientY, boundsRect.top, boundsRect.bottom);

    const relX = x - boundsRect.left;
    const relY = y - boundsRect.top + POINTER_GAP;

    return {
      x: clamp(relX, copyWidth / 2, boundsRect.width - copyWidth / 2),
      y: clamp(relY, 0, boundsRect.height - copyHeight),
    };
  };

  const applyCopyPosition = (x: number, y: number) => {
    if (!hasFinePointer) return;

    heroCopy.style.left = `${x}px`;
    heroCopy.style.top = `${y}px`;
    heroCopy.style.transform = 'translate(-50%, 0)';
  };

  const setTargetFromPointer = (clientX: number, clientY: number) => {
    const { x, y } = getTargetPosition(clientX, clientY);
    targetX = x;
    targetY = y;
  };

  const centerCopy = () => {
    const boundsRect = copyBounds.getBoundingClientRect();
    setTargetFromPointer(
      boundsRect.left + boundsRect.width / 2,
      boundsRect.top + boundsRect.height / 2 - POINTER_GAP,
    );
    currentX = targetX;
    currentY = targetY;
    applyCopyPosition(currentX, currentY);
  };

  const onPointerMove = (event: PointerEvent) => {
    if (!hasFinePointer) return;

    pointerX = event.clientX;
    pointerY = event.clientY;
    hasPointer = true;
    setTargetFromPointer(pointerX, pointerY);

    if (prefersReducedMotion) {
      currentX = targetX;
      currentY = targetY;
      applyCopyPosition(currentX, currentY);
    }
  };

  const tick = (time: number) => {
    const delta = lastFrameTime ? (time - lastFrameTime) / 1000 : 1 / 60;
    lastFrameTime = time;

    const ease = 1 - Math.exp(-SMOOTHNESS * delta);
    currentX += (targetX - currentX) * ease;
    currentY += (targetY - currentY) * ease;
    applyCopyPosition(currentX, currentY);
    rafId = requestAnimationFrame(tick);
  };

  const update = () => {
    syncHeaderHeight();
    fitName();

    if (!hasFinePointer) {
      resetStaticCopyLayout();
      return;
    }

    syncCopyBounds();

    if (hasPointer) {
      setTargetFromPointer(pointerX, pointerY);
    } else {
      centerCopy();
      return;
    }

    applyCopyPosition(currentX, currentY);
  };

  update();
  document.fonts?.ready.then(update);

  if (header) {
    new ResizeObserver(update).observe(header);
  }

  new ResizeObserver(update).observe(container);
  new ResizeObserver(update).observe(heroCopy);

  window.addEventListener('resize', update, { passive: true });

  window.matchMedia('(pointer: fine)').addEventListener('change', update);

  if (hasFinePointer) {
    window.addEventListener('pointermove', onPointerMove, { passive: true });

    if (!prefersReducedMotion) {
      rafId = requestAnimationFrame(tick);
    }
  }

  document.addEventListener(
    'astro:before-swap',
    () => {
      window.removeEventListener('pointermove', onPointerMove);
      cancelAnimationFrame(rafId);
    },
    { once: true },
  );
</script>
