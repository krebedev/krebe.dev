---
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="relative z-10 border-t border-border/60 bg-muted">
  <div class="mx-auto flex max-w-6xl flex-col gap-4 px-6 py-10 text-sm text-muted-foreground sm:flex-row sm:items-center sm:justify-between lg:px-10">
    <p>&copy; {year} {site.name}</p>
    <a
      href={`mailto:${site.email}`}
      class="transition hover:text-primary"
    >
      {site.email}
    </a>
  </div>
</footer>
