---
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-muted">
  <div class="mx-auto flex max-w-5xl flex-col items-center justify-between gap-2 px-4 py-6 text-sm text-muted-foreground sm:flex-row sm:px-6">
    <p>&copy; {year} {site.name}</p>
    <p>Built with Astro &amp; Tailwind</p>
  </div>
</footer>
