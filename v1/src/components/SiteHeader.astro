---
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import { nav } from '../data/site';

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 w-full bg-background/90 backdrop-blur-md">
  <div class="flex w-full items-center justify-between gap-6 px-6 py-5 lg:px-10">
    <a href="/" class="transition-opacity hover:opacity-80" aria-label="krebe.dev home">
      <Logo />
    </a>

    <div class="flex items-center gap-6">
      <nav aria-label="Main">
        <ul class="flex items-center gap-1">
          {
            nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  class:list={[
                    'px-4 py-2 text-sm font-medium tracking-wide transition',
                    currentPath === item.href
                      ? 'text-primary'
                      : 'text-muted-foreground hover:text-foreground',
                  ]}
                  aria-current={currentPath === item.href ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <ThemeToggle />
    </div>
  </div>
</header>
