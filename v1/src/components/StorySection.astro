---
import { storyBlocks } from "../data/story";
import Button from "./Button.astro";

const isQuestion = (line: string) => line.startsWith('"') && line.endsWith('"');
---

<section id='story' class='story-section relative z-10 bg-muted pb-10'>
  <div class='mx-auto max-w-2xl px-6 py-20 sm:py-28 lg:px-10'>
    {
      storyBlocks.map((block, index) => {
        if (block.type === "h2") {
          return (
            <div
              data-reveal
              class='story-reveal mb-10 sm:mb-12'
              style={`--reveal-delay: ${index * 30}ms`}
            >
              <h2 class='text-2xl font-medium tracking-tight text-heading sm:text-3xl'>
                {block.text}
              </h2>
            </div>
          );
        }

        if (block.type === "h3") {
          return (
            <div
              data-reveal
              class='story-reveal mb-6 mt-14 sm:mt-16'
              style={`--reveal-delay: ${index * 30}ms`}
            >
              <h3 class='text-xs font-medium uppercase tracking-[0.15em] text-primary sm:text-sm'>
                {block.text}
              </h3>
            </div>
          );
        }

        const isShort = block.lines.length === 1 && block.lines[0].length < 48;

        return (
          <div
            data-reveal
            class:list={[
              "story-reveal mb-8 sm:mb-10",
              isShort && "story-reveal--punch",
            ]}
            style={`--reveal-delay: ${index * 30}ms`}
          >
            {block.lines.map((line) => (
              <p
                class:list={[
                  "story-line text-lg leading-relaxed text-foreground sm:text-xl",
                  isQuestion(line) &&
                    "border-l-2 border-primary/40 pl-5 italic",
                ]}
              >
                {line}
              </p>
            ))}
          </div>
        );
      })
    }
  </div>
</section>

<script>
  const story = document.getElementById("story");
  if (!story) throw new Error("Story section not found");

  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;
  const reveals = story.querySelectorAll("[data-reveal]");

  if (prefersReducedMotion) {
    reveals.forEach((el) => el.classList.add("is-visible"));
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
          }
        });
      },
      { rootMargin: "-8% 0px -12% 0px", threshold: 0 },
    );

    reveals.forEach((el) => observer.observe(el));
  }
</script>
