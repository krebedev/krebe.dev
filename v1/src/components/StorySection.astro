---
import { storyBlocks } from "../data/story";
import { site } from "../data/site";

const isQuestion = (line: string) => line.startsWith('"') && line.endsWith('"');

const closingSocial = [
  { label: "GitHub", href: site.social.github },
  { label: "LinkedIn", href: site.social.linkedIn },
] as const;

let h2Count = 0;
let indexInSection = 0;

function revealDelay(block: (typeof storyBlocks)[number]): number {
  if (block.type === "h2") {
    indexInSection = 0;
    return 0;
  }

  indexInSection += 1;
  return indexInSection * 45;
}
---

<section id="story" class="story-section relative z-10 scroll-mt-[var(--site-header-height,5rem)]">
  <div class="mx-auto max-w-2xl px-6 py-20 sm:py-28 lg:px-10">
    {
      storyBlocks.map((block) => {
        const delay = revealDelay(block);

        if (block.type === "h2") {
          const isFirst = h2Count === 0;
          h2Count += 1;

          return (
            <div
              data-reveal
              class:list={[
                "story-reveal story-chapter",
                !isFirst && "story-chapter--continued",
              ]}
              style={`--reveal-delay: ${delay}ms`}
            >
              <h2 class="text-2xl font-medium tracking-tight text-heading sm:text-3xl">
                {block.text}
              </h2>
            </div>
          );
        }

        if (block.type === "h3") {
          return (
            <div
              data-reveal
              class="story-reveal story-subhead"
              style={`--reveal-delay: ${delay}ms`}
            >
              <h3 class="text-xs font-medium uppercase tracking-[0.15em] text-primary sm:text-sm">
                {block.text}
              </h3>
            </div>
          );
        }

        const isShort = block.lines.length === 1 && block.lines[0].length < 48;

        return (
          <div
            data-reveal
            class:list={[
              "story-reveal story-stanza",
              isShort && "story-reveal--punch",
            ]}
            style={`--reveal-delay: ${delay}ms`}
          >
            {block.lines.map((line) => (
              <p
                class:list={[
                  "story-line text-lg leading-[1.75] text-foreground sm:text-xl sm:leading-[1.7]",
                  isQuestion(line) && "story-quote",
                ]}
              >
                {line}
              </p>
            ))}
          </div>
        );
      })
    }

    <div
      id="contact"
      data-reveal
      class="story-reveal story-closing"
      style={`--reveal-delay: ${(indexInSection + 1) * 45}ms`}
    >
      <p class="text-xs font-medium uppercase tracking-[0.15em] text-primary">
        Get in touch
      </p>

      <p class="mt-4 text-lg leading-relaxed text-foreground sm:text-xl">
        {site.closing}
      </p>

      <a
        href={`mailto:${site.email}`}
        class="story-link mt-6 inline-block text-xl font-medium text-foreground transition hover:text-primary sm:text-2xl"
      >
        {site.email}
      </a>

      <p class="mt-6 text-base text-muted-foreground sm:text-lg">
        <a
          href={closingSocial[0].href}
          target="_blank"
          rel="noopener noreferrer"
          class="story-link transition hover:text-primary"
        >
          {closingSocial[0].label}
        </a>
        <span aria-hidden="true"> · </span>
        <a
          href={closingSocial[1].href}
          target="_blank"
          rel="noopener noreferrer"
          class="story-link transition hover:text-primary"
        >
          {closingSocial[1].label}
        </a>
      </p>
    </div>
  </div>
</section>

<script>
  const story = document.getElementById("story");
  if (!story) throw new Error("Story section not found");

  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;
  const reveals = story.querySelectorAll("[data-reveal]");

  if (prefersReducedMotion) {
    reveals.forEach((el) => el.classList.add("is-visible"));
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
          }
        });
      },
      { rootMargin: "-8% 0px -12% 0px", threshold: 0 },
    );

    reveals.forEach((el) => observer.observe(el));
  }
</script>
