---
interface Props {
  href: string;
}

const { href } = Astro.props;
---

<a
  href={href}
  class="group inline-flex items-center gap-2 rounded-full bg-primary px-7 py-3.5 text-sm font-semibold tracking-wide text-primary-foreground transition hover:bg-orange-deep focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
>
  <slot />
  <span
    class="transition-transform group-hover:translate-x-0.5"
    aria-hidden="true"
  >
    →
  </span>
</a>
